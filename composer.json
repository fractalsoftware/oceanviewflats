{
  "name": "oceanviewflats/backend-api",
  "description": "OceanViewFlats PHP REST API with OpenAPI Specification",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "zircote/swagger-php": "^4.11",
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "OceanViewFlats\\Api\\": "public/api/",
      "OceanViewFlats\\Domain\\": "src/Domain/",
      "OceanViewFlats\\Admin\\": "admin/src/",
      "OceanViewFlats\\Infrastructure\\": "src/Infrastructure/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OceanViewFlats\\Tests\\": "tests/",
      "OceanViewFlats\\Admin\\Tests\\": "admin/tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=512M",
    "admin:test": "phpunit -c admin/phpunit.xml",
    "admin:phpstan": "phpstan analyse -c admin/phpstan.neon --memory-limit=512M",
    "generate-docs": "php scripts/generate-docs.php"
  },
  "config": {
    "allow-plugins": {}
  }
}
