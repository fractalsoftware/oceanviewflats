# =============================================================================
# OceanViewFlats - Admin Subdomain Apache Configuration (Pattern A)
# Subdomain: admin.oceanviewflats.com
# DocumentRoot: /home/<user>/admin/public
# =============================================================================

# 1. Directory Indexing & Directory Browsing
DirectoryIndex index.php
Options -Indexes

# 2. Block direct web access to hidden files and directories (.env, .git, .htaccess, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. HTTP Security Headers
<IfModule mod_headers.c>
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Static Asset MIME Types (PWA Web App Manifest & Vector Icons)
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
</IfModule>

# 5. Front-Controller URL Rewriting & Request Hardening (CVE-2026-109618 & CVE-2026-109619)
LimitRequestBody 65536

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Reject multipart/form-data payloads before PHP startup (Admin Console uses URL-encoded forms)
    RewriteCond %{CONTENT_TYPE} ^multipart/form-data [NC]
    RewriteRule ^ - [F,L]

    # Route all non-file and non-directory requests to the front-controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# 6. Guarded PHP Engine Directives for mod_php / LiteSpeed SAPIs
<IfModule mod_php.c>
    php_flag file_uploads Off
    php_flag session.upload_progress.enabled Off
    php_value post_max_size 64K
    php_value max_input_nesting_level 16
    php_value max_input_vars 200
</IfModule>
<IfModule mod_php8.c>
    php_flag file_uploads Off
    php_flag session.upload_progress.enabled Off
    php_value post_max_size 64K
    php_value max_input_nesting_level 16
    php_value max_input_vars 200
</IfModule>
<IfModule lsapi_module>
    php_flag file_uploads Off
    php_flag session.upload_progress.enabled Off
    php_value post_max_size 64K
    php_value max_input_nesting_level 16
    php_value max_input_vars 200
</IfModule>

# =============================================================================
# Environment Variables (Injected during deployment)
# =============================================================================
# Production secrets and environment variables are injected below during deployment.
# Do not commit live credentials to version control.
#
# Examples:
# SetEnv DB_HOST "localhost"
# SetEnv DB_NAME "oceanview_db"
# SetEnv DB_USER "oceanview_user"
# SetEnv DB_PASS "secret_password"
# SetEnv MERCADOPAGO_ACCESS_TOKEN "APP_USR-..."
# SetEnv MERCADOPAGO_PUBLIC_KEY "APP_USR-..."
# SetEnv PROPERTY_ID "1"
# SetEnv APP_ENV "production"
# SetEnv HUESPED_MANAGER_BASE_URL "https://salguerosunset.huespedmanager.com.co/propietarios/production"
# SetEnv HUESPED_MANAGER_1707_CHECK "ep92449222"
# SetEnv HUESPED_MANAGER_1606_CHECK "ep24281580"
