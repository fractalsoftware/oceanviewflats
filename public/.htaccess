ErrorDocument 404 /404.html

# =============================================================================
# Security Hardening & Directory Protection
# =============================================================================

# 0. Disable directory listing and deny access to dotfiles / sensitive operational files
Options -Indexes

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|bak|log|env|lock|ini|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# HTTP Security Headers (safe initial HSTS without preload)
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
    Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self)"
    # Staged CSP rollout (Report-Only initially to validate Mercado Pago Checkout Bricks, Matomo, Google Fonts, and FX API origins)
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://sdk.mercadopago.com https://api-static.mercadopago.com https://http2.mlstatic.com https://stats.fractalserver.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://http2.mlstatic.com; font-src 'self' https://fonts.gstatic.com https://http2.mlstatic.com data:; img-src 'self' data: https://http2.mlstatic.com https://api-static.mercadopago.com https://stats.fractalserver.com; connect-src 'self' https://api.mercadopago.com https://api-static.mercadopago.com https://sdk.mercadopago.com https://http2.mlstatic.com https://stats.fractalserver.com https://open.er-api.com; frame-src 'self' https://sdk.mercadopago.com https://api-static.mercadopago.com https://www.mercadopago.com https://www.mercadopago.com.co; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# =============================================================================
# Request Hardening (CVE-2026-109618 & CVE-2026-109619 Mitigations)
# =============================================================================

# 1. Cap HTTP request body size at Apache layer (64 KB max)
LimitRequestBody 65536

# 2. Reject multipart/form-data requests before PHP startup and enforce canonical URL redirects
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Reject multipart/form-data requests before PHP startup (must run before any redirect)
    RewriteCond %{CONTENT_TYPE} ^multipart/form-data [NC]
    RewriteRule ^ - [F,L]

    # Permanently strip explicit index.html requests to canonical trailing-slash directory URLs
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+([^?\s]*/)?index\.html[\s?] [NC]
    RewriteRule ^ https://www.oceanviewflats.com/%1 [R=301,L]

    # Permanently canonicalize HTTP and apex host requests to https://www.oceanviewflats.com
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^www\.oceanviewflats\.com$ [NC]
    RewriteRule ^(.*)$ https://www.oceanviewflats.com/$1 [R=301,L]
</IfModule>
