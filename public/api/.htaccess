# =============================================================================
# OceanViewFlats - API Folder Apache Security Configuration
# =============================================================================

# 1. Disable directory index browsing (avoids file listing leaks)
Options -Indexes

# 2. Block direct web access to internal configuration, utility, and SQL schema files
<FilesMatch "^(config|utils|schema|translations|OpenApi)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block web access to internal logs, rate limits, or lockfiles
<FilesMatch "^(ovf_|composer|\.).*\.(json|lock|log|sql|bak|config)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Explicitly allow public OpenAPI specification files
<FilesMatch "^openapi\.(json|yaml)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Allow from all
    </IfModule>
</FilesMatch>

# 4. Enforce basic frame protection and mime sniffing headers via Apache (if mod_headers is active)
<IfModule mod_headers.c>
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Mitigate PHP Request Startup & Stale State Vulnerabilities (CVE-2026-109618 & CVE-2026-109619)
# Cap HTTP request body size at 64 KB at the Apache layer before PHP initializes
LimitRequestBody 65536

# Reject multipart/form-data requests outright (API exclusively accepts JSON and URL-encoded bodies)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{CONTENT_TYPE} ^multipart/form-data [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# Guarded PHP engine directives for mod_php / LiteSpeed SAPIs
<IfModule mod_php.c>
    php_flag file_uploads Off
    php_flag session.upload_progress.enabled Off
    php_value post_max_size 64K
    php_value max_input_nesting_level 16
    php_value max_input_vars 200
</IfModule>
<IfModule mod_php8.c>
    php_flag file_uploads Off
    php_flag session.upload_progress.enabled Off
    php_value post_max_size 64K
    php_value max_input_nesting_level 16
    php_value max_input_vars 200
</IfModule>
<IfModule lsapi_module>
    php_flag file_uploads Off
    php_flag session.upload_progress.enabled Off
    php_value post_max_size 64K
    php_value max_input_nesting_level 16
    php_value max_input_vars 200
</IfModule>

