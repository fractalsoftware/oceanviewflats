# OceanViewFlats Environment Variables Template
# Copy this file to .env in your production or local development environment

# =============================================================================
# Contact & Captcha Settings
# =============================================================================
# Mailbox receiving customer inquiries and administrative notifications
RECIPIENT_EMAIL=contact@oceanviewflats.com

# Cryptographic salt for signing and verifying the Math Captcha
CAPTCHA_SECRET=random_secure_salt_secret

# =============================================================================
# Data Protection & Encryption (Ley 1581 of 2012)
# =============================================================================
# Symmetric key for XSalsa20-Poly1305 encryption of guest_registries.guests_payload at rest
APP_ENCRYPTION_KEY=your_32_byte_or_64_hex_encryption_key_here

# =============================================================================
# Database Configuration (MySQL / MariaDB)
# =============================================================================
DB_HOST=127.0.0.1
DB_NAME=oceanviewflats_db
DB_USER=root
DB_PASS=local_db_password

# =============================================================================
# Payment Processing (Mercado Pago)
# =============================================================================
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_SANDBOX=false

# =============================================================================
# Property Access Fallbacks (Emergency Smart Lock PINs & Wi-Fi)
# =============================================================================
PROPERTY_1606_DOOR_CODE=0160600#
PROPERTY_1606_WIFI_SSID=APTO1606
PROPERTY_1606_WIFI_PASSWORD=Invitado@1606@HN

PROPERTY_1707_DOOR_CODE=0170700#
PROPERTY_1707_WIFI_SSID=APTO1707
PROPERTY_1707_WIFI_PASSWORD=Invitado@1707@HN

# =============================================================================
# Administrative Session Security
# =============================================================================
# 64-character random hex string for signing session cookies and CSRF tokens
OVF_ADMIN_SESSION_SECRET=your_64_character_hex_session_secret_here

# =============================================================================
# Condominium Administration Portal (Huésped Manager)
# =============================================================================
# Base endpoint for the reception and clearance registration system
HUESPED_MANAGER_BASE_URL=https://salguerosunset.huespedmanager.com.co/propietarios/production

# Pre-shared security check tokens for Edificio Salguero Sunset properties
HUESPED_MANAGER_1707_CHECK=ep92449222
HUESPED_MANAGER_1606_CHECK=ep24281580
